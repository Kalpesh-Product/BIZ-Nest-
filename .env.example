# Application listener and public canonical origin
PORT=3011
SITE_URL=https://biznest.co.in

# MongoDB (server-only; keep credentials out of Git)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=biznest
MONGODB_MAX_POOL_SIZE=10
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Submission body/upload limits (bytes)
MAX_REQUEST_BYTES=6000000
MAX_RESUME_BYTES=5000000

# Shared submission throttling
INQUIRY_RATE_LIMIT_MAX=10
INQUIRY_RATE_LIMIT_WINDOW_MS=900000

# Optional server-to-server notification after a successful database save
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_TOKEN=
INQUIRY_WEBHOOK_TIMEOUT_MS=15000

# Optional overrides for tooling (normally leave unset)
# BACKEND_TEST_PORT=3013
# NEXT_DIST_DIR=.next-production
